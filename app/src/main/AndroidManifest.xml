<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Lock-screen / background media playback service -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Media-session notifications are exempt from this runtime grant on 33+,
         but declaring it keeps the notification channel fully authorized. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Google Drive backup (opt-in): the network is used only when the user
         connects a Google account in Settings and syncs or restores. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Package-visibility declarations (Android 11+, API 30+): without these,
         resolveActivity() returns null even when suitable apps ARE installed.
         The Contact Us screen launches intents directly and no longer relies
         on a resolve pre-check, but these keep any future query truthful. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.SENDTO" />
            <data android:scheme="mailto" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
    </queries>

    <!--
      allowBackup is deliberately false: Android Auto Backup would otherwise
      silently upload the private database AND voice recordings to Google
      Drive. Backup/restore is handled exclusively by the in-app,
      user-controlled ZIP export/import in Settings, plus the optional
      user-connected Google Drive sync (also in Settings). Auto Backup stays
      off either way.
    -->
    <application
        android:name=".NaatBookApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.MyApplication">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.MyApplication.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Media3 owns the foreground notification, MediaSession, and media-button routing. -->
        <service
            android:name=".audio.MediaPlaybackService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback"
            android:stopWithTask="false">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaSessionService" />
            </intent-filter>
        </service>
    </application>

</manifest>
